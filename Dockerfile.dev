ARG NODE_VERSION=26

FROM node:${NODE_VERSION}-slim AS base

RUN corepack enable

ENV NODE_ENV=development

WORKDIR /src

# Build
FROM base AS build

COPY --link package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install

# Run
FROM base

COPY --from=build /src/node_modules /src/node_modules

CMD [ "pnpm", "run", "dev" ]