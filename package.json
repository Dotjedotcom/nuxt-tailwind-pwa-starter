{
  "name": "dotinga.com-nuxt-tailwind-pwa",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate-pwa-assets": "pwa-assets-generator",
    "lint": "pnpm run lint:ts && pnpm run lint:css",
    "lint:fix": "pnpm run lint:ts:fix && pnpm run lint:css:fix",
    "lint:ts": "eslint .",
    "lint:ts:fix": "eslint . --fix",
    "lint:css": "stylelint \"app/**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"app/**/*.{css,vue}\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "2.6.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.4.0",
    "@nuxt/ui": "4.12.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@unhead/vue": "3.4.3",
    "eslint": "10.14.0",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "imagetracerjs": "^1.2.6",
  "canvas": "^2.11.2",
  "devDependencies": {
    "@vite-pwa/assets-generator": "2.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
